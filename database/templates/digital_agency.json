{
  "name": "Digital & Marketing Agency",
  "industry": "digital_agency",
  "description": "Inbound client discovery, pitch decks, proposals, and retainer closes for creative agencies.",
  "pipelines": [
    {
      "name": "Client Acquisition",
      "slug": "clients",
      "is_default": true,
      "stages": [
        { "name": "Inbound Lead", "slug": "new", "color": "#3b82f6", "sort_order": 1, "sla_hours": 2 },
        { "name": "Discovery Call Booked", "slug": "discovery", "color": "#06b6d4", "sort_order": 2, "sla_hours": 24 },
        { "name": "Scope & Briefing", "slug": "briefing", "color": "#8b5cf6", "sort_order": 3, "sla_hours": 48 },
        { "name": "Proposal / Pitch Sent", "slug": "proposal-sent", "color": "#f59e0b", "sort_order": 4, "sla_hours": 72 },
        { "name": "Negotiation / Contract", "slug": "contract", "color": "#ec4899", "sort_order": 5, "sla_hours": 48 },
        { "name": "Closed Won (Retainer)", "slug": "won", "color": "#10b981", "sort_order": 6, "is_won": true },
        { "name": "Lost / Competitor Chosen", "slug": "lost", "color": "#6b7280", "sort_order": 7, "is_lost": true }
      ]
    }
  ],
  "services": ["Search Engine Optimisation (SEO)", "Paid Search & Meta Ads", "Web Design & Development", "Brand Identity", "Content & Social Media", "Conversion Rate Optimisation"],
  "urgency_keywords": ["launch deadline", "rebrand", "q4 budget", "funded", "immediate start"],
  "tags": [
    { "name": "Enterprise Budget", "color": "#10b981" },
    { "name": "Fast Decision", "color": "#ef4444" },
    { "name": "Inbound Organic", "color": "#3b82f6" },
    { "name": "SaaS / Tech", "color": "#8b5cf6" }
  ],
  "forms": [
    {
      "name": "Project Discovery Form",
      "slug": "agency-discovery",
      "description": "Capture project requirements, goals, and budget range.",
      "fields": [
        { "name": "name", "label": "Your Name", "type": "text", "required": true },
        { "name": "company", "label": "Company / Brand", "type": "text", "required": true },
        { "name": "email", "label": "Work Email", "type": "email", "required": true },
        { "name": "phone", "label": "Phone", "type": "phone", "required": false },
        { "name": "service", "label": "Primary Objective", "type": "select", "required": true, "options": ["Web Design & Development", "Paid Search & Meta Ads", "SEO & Organic Growth", "Brand Identity"] },
        { "name": "budget", "label": "Estimated Monthly Budget", "type": "select", "required": true, "options": ["£2,000 - £5,000", "£5,000 - £10,000", "£10,000 - £25,000", "£25,000+"] },
        { "name": "details", "label": "Tell us about your project and timeline", "type": "textarea", "required": true },
        { "name": "consent", "label": "I agree to receive communications regarding my proposal.", "type": "checkbox", "required": true }
      ]
    }
  ],
  "templates": [
    {
      "name": "Agency Project Acknowledged",
      "slug": "agency-ack",
      "subject": "Thanks for reaching out to {{tenant_name}} — Project Brief",
      "channel": "email",
      "body": "Hi {{name}},\n\nThanks for reaching out to {{tenant_name}} regarding your {{service}} project.\n\nWe've reviewed your submission and would love to schedule a 20-minute discovery call.\n\nPick a time that suits you best here: {{booking_url}}\n\nCheers,\n{{tenant_name}}"
    }
  ],
  "automations": [
    {
      "name": "Agency Discovery Acknowledgement",
      "trigger_type": "lead_created",
      "conditions": [],
      "actions": [
        { "type": "send_email", "template_slug": "agency-ack" },
        { "type": "create_task", "title": "Research company background & LinkedIn", "due_hours": 4 }
      ]
    }
  ]
}
