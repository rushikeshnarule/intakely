{
  "name": "Home Services & Contractors",
  "industry": "home_services",
  "description": "Plumbing, electrical, HVAC, roofing, and construction contractors with site visit quoting.",
  "pipelines": [
    {
      "name": "Jobs & Quotes",
      "slug": "jobs",
      "is_default": true,
      "stages": [
        { "name": "New Job Request", "slug": "new", "color": "#3b82f6", "sort_order": 1, "sla_hours": 1 },
        { "name": "Contacted / Scoping", "slug": "contacted", "color": "#06b6d4", "sort_order": 2, "sla_hours": 4 },
        { "name": "Site Visit Booked", "slug": "site-visit", "color": "#8b5cf6", "sort_order": 3, "sla_hours": 48 },
        { "name": "Estimate / Quote Sent", "slug": "quote-sent", "color": "#f59e0b", "sort_order": 4, "sla_hours": 24 },
        { "name": "Job Won & Scheduled", "slug": "won", "color": "#10b981", "sort_order": 5, "is_won": true },
        { "name": "Declined / Lost", "slug": "lost", "color": "#6b7280", "sort_order": 6, "is_lost": true }
      ]
    }
  ],
  "services": ["Boiler Repair & Installation", "Electrical Rewiring & EV Chargers", "Plumbing & Leak Detection", "Roofing & Guttering", "Kitchen & Bathroom Fitting", "Emergency Callout"],
  "urgency_keywords": ["leak", "burst pipe", "no heat", "power cut", "flooding", "emergency", "sparks"],
  "tags": [
    { "name": "Emergency", "color": "#ef4444" },
    { "name": "Commercial", "color": "#8b5cf6" },
    { "name": "Residential", "color": "#3b82f6" },
    { "name": "Insurance Claim", "color": "#f59e0b" }
  ],
  "forms": [
    {
      "name": "Request a Free Quote",
      "slug": "quote-request",
      "description": "Fast estimate request with postcode and problem description.",
      "fields": [
        { "name": "name", "label": "Name", "type": "text", "required": true },
        { "name": "phone", "label": "Phone Number", "type": "phone", "required": true },
        { "name": "email", "label": "Email", "type": "email", "required": false },
        { "name": "postcode", "label": "Postcode", "type": "text", "required": true },
        { "name": "service", "label": "Trade / Service Required", "type": "select", "required": true, "options": ["Boiler Repair & Heating", "Plumbing & Leaks", "Electrical & Lighting", "Roofing & Gutters", "General Building"] },
        { "name": "details", "label": "Tell us about the issue", "type": "textarea", "required": true },
        { "name": "consent", "label": "I consent to an engineer contacting me with an estimate.", "type": "checkbox", "required": true }
      ]
    }
  ],
  "templates": [
    {
      "name": "Trade Quote Request Received",
      "slug": "quote-ack",
      "subject": "We received your quote request — {{tenant_name}}",
      "channel": "sms",
      "body": "Hi {{name}}, thanks for contacting {{tenant_name}}. An engineer is reviewing your {{service}} request and will call you shortly to confirm a quote."
    }
  ],
  "automations": [
    {
      "name": "Instant Contractor SMS",
      "trigger_type": "lead_created",
      "conditions": [],
      "actions": [
        { "type": "send_sms", "template_slug": "quote-ack" },
        { "type": "create_task", "title": "Check engineer availability in area", "due_hours": 1 }
      ]
    }
  ]
}
