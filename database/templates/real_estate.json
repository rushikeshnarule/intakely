{
  "name": "Real Estate Agency",
  "industry": "real_estate",
  "description": "Property inquiries, buyers, sellers, landlords, and tenant viewing management.",
  "pipelines": [
    {
      "name": "Sales & Lettings",
      "slug": "sales-lettings",
      "is_default": true,
      "stages": [
        { "name": "New Property Enquiry", "slug": "new", "color": "#3b82f6", "sort_order": 1, "sla_hours": 2 },
        { "name": "Buyer / Seller Qualified", "slug": "qualified", "color": "#06b6d4", "sort_order": 2, "sla_hours": 12 },
        { "name": "Viewing Booked", "slug": "viewing-booked", "color": "#8b5cf6", "sort_order": 3, "sla_hours": 48 },
        { "name": "Viewing Completed / Feedback", "slug": "viewed", "color": "#f59e0b", "sort_order": 4, "sla_hours": 24 },
        { "name": "Offer Submitted", "slug": "offer-submitted", "color": "#ec4899", "sort_order": 5, "sla_hours": 12 },
        { "name": "Offer Accepted / Sold", "slug": "sold", "color": "#10b981", "sort_order": 6, "is_won": true },
        { "name": "Withdrawn / Lost", "slug": "lost", "color": "#6b7280", "sort_order": 7, "is_lost": true }
      ]
    }
  ],
  "services": ["Residential Sales", "Lettings & Management", "Property Valuation", "Commercial Real Estate", "Land & New Homes"],
  "urgency_keywords": ["cash buyer", "chain free", "immediate move", "auction", "relocation"],
  "tags": [
    { "name": "Cash Buyer", "color": "#10b981" },
    { "name": "Chain Free", "color": "#3b82f6" },
    { "name": "Investor", "color": "#8b5cf6" },
    { "name": "Landlord", "color": "#f59e0b" }
  ],
  "forms": [
    {
      "name": "Property Viewing Request",
      "slug": "property-viewing",
      "description": "Book a viewing for an active property listing.",
      "fields": [
        { "name": "name", "label": "Full Name", "type": "text", "required": true },
        { "name": "email", "label": "Email", "type": "email", "required": true },
        { "name": "phone", "label": "Phone Number", "type": "phone", "required": true },
        { "name": "service", "label": "Looking to", "type": "select", "required": true, "options": ["Buy", "Rent", "Sell my property", "Request free valuation"] },
        { "name": "budget", "label": "Budget / Price Range", "type": "text", "required": false },
        { "name": "consent", "label": "I consent to receiving property matches and viewing updates.", "type": "checkbox", "required": true }
      ]
    }
  ],
  "templates": [
    {
      "name": "Viewing Request Confirmed",
      "slug": "viewing-ack",
      "subject": "Viewing Request Received — {{tenant_name}}",
      "channel": "email",
      "body": "Hi {{name}},\n\nThanks for your interest in property viewings with {{tenant_name}}.\n\nOur agent will confirm availability and send you the calendar invite.\n\nBest,\n{{tenant_name}}"
    }
  ],
  "automations": [
    {
      "name": "Viewing Enquiry Acknowledged",
      "trigger_type": "lead_created",
      "conditions": [],
      "actions": [
        { "type": "send_email", "template_slug": "viewing-ack" },
        { "type": "create_task", "title": "Check agent diary & confirm viewing slot", "due_hours": 3 }
      ]
    }
  ]
}
