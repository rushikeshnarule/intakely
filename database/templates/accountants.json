{
  "name": "Accountants & Financial Consultants",
  "industry": "accountants",
  "description": "Chartered accountants, tax advisors, and management consultants with engagement letter gates.",
  "pipelines": [
    {
      "name": "Client Onboarding",
      "slug": "onboarding",
      "is_default": true,
      "stages": [
        { "name": "New Financial Enquiry", "slug": "new", "color": "#3b82f6", "sort_order": 1, "sla_hours": 4 },
        { "name": "Introductory Call", "slug": "intro-call", "color": "#06b6d4", "sort_order": 2, "sla_hours": 24 },
        { "name": "Fee Proposal Sent", "slug": "fee-proposal", "color": "#f59e0b", "sort_order": 3, "sla_hours": 48 },
        { "name": "Engagement Letter & AML", "slug": "engagement-letter", "color": "#ec4899", "sort_order": 4, "required_fields": ["engagement_letter_signed", "id_verified"] },
        { "name": "Active Client (Onboarded)", "slug": "active", "color": "#10b981", "sort_order": 5, "is_won": true },
        { "name": "Lost / Not Proceeding", "slug": "lost", "color": "#6b7280", "sort_order": 6, "is_lost": true }
      ]
    }
  ],
  "services": ["Year-End Accounts & Tax Returns", "Bookkeeping & VAT", "Payroll & CIS", "R&D Tax Credits", "Corporate Finance & M&A", "Personal Tax Planning"],
  "urgency_keywords": ["hmrc deadline", "fine", "late filing", "penalties", "tax audit"],
  "tags": [
    { "name": "Limited Company", "color": "#3b82f6" },
    { "name": "Sole Trader", "color": "#06b6d4" },
    { "name": "HMRC Deadline", "color": "#ef4444" },
    { "name": "High Net Worth", "color": "#10b981" }
  ],
  "forms": [
    {
      "name": "Accounting Intake",
      "slug": "accounting-intake",
      "description": "Business information and accounting requirements.",
      "fields": [
        { "name": "name", "label": "Full Name", "type": "text", "required": true },
        { "name": "company", "label": "Company Name (if applicable)", "type": "text", "required": false },
        { "name": "email", "label": "Email Address", "type": "email", "required": true },
        { "name": "phone", "label": "Phone Number", "type": "phone", "required": true },
        { "name": "service", "label": "Service Required", "type": "select", "required": true, "options": ["Year-End Accounts & Tax", "Bookkeeping & VAT", "Payroll", "R&D Tax Credits", "Tax Advisory"] },
        { "name": "turnover", "label": "Approximate Annual Turnover", "type": "select", "required": false, "options": ["Under £100k", "£100k - £500k", "£500k - £2m", "£2m+"] },
        { "name": "consent", "label": "I consent to receiving fee proposal and accounting updates.", "type": "checkbox", "required": true }
      ]
    }
  ],
  "templates": [
    {
      "name": "Accounting Enquiry Acknowledged",
      "slug": "accounting-ack",
      "subject": "Thanks for contacting {{tenant_name}} — Accounting Enquiry",
      "channel": "email",
      "body": "Dear {{name}},\n\nThank you for reaching out to {{tenant_name}} regarding {{service}}.\n\nOur client advisory team is reviewing your requirements and will reach out with a tailored fee guide within 1 business day.\n\nBest regards,\n{{tenant_name}}"
    }
  ],
  "automations": [
    {
      "name": "Accounting Enquiry Acknowledgement",
      "trigger_type": "lead_created",
      "conditions": [],
      "actions": [
        { "type": "send_email", "template_slug": "accounting-ack" },
        { "type": "create_task", "title": "Check Companies House filing history", "due_hours": 4 }
      ]
    }
  ]
}
