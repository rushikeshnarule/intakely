APP_NAME=Intakely
APP_ENV=local
APP_URL=http://localhost:8000
APP_KEY=change-me-to-a-random-64-char-string

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intakely
DB_USER=intakely_app
DB_PASS=intakely_secret
DB_MIGRATOR_USER=intakely_owner
DB_MIGRATOR_PASS=intakely_owner_secret

# Session
SESSION_LIFETIME=120
SESSION_SECURE=false

# Mail (log|smtp|mailgun)
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=noreply@intakely.com
MAIL_FROM_NAME=Intakely

# SMS (log|twilio)
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp (log|cloud)
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# AI (mock|anthropic)
AI_DRIVER=mock
ANTHROPIC_API_KEY=
AI_MONTHLY_CREDIT_LIMIT=1000

# Stripe (fake|stripe)
BILLING_DRIVER=fake
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Encryption (libsodium key, base64 encoded)
ENCRYPTION_KEY=

# Turnstile (optional spam protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Demo mode
DEMO_MODE=true
DEMO_LOGINS=true
